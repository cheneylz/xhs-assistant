{
  "name": "xhs-assistant",
  "version": "0.2.0",
  "private": true,
  "description": "小红书运营平台助手（Next.js 全量重写版）",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:import": "node --env-file-if-exists=.env --import tsx src/scripts/import_old_db.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.16.0",
    "antd": "^6.3.7",
    "axios": "^1.13.2",
    "crypto-js": "^4.2.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.562.0",
    "next": "^15.5.0",
    "node-cron": "^3.0.3",
    "p-retry": "^6.2.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "sharp": "^0.34.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
