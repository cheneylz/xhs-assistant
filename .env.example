# =====================================================
# xhs-assistant 环境变量配置示例
# 使用前复制为 .env 并填写真实值；.env 已被 gitignore，不会入库
# =====================================================

# ---- 数据库（PostgreSQL）----
# 需先创建数据库：CREATE DATABASE xhs_crawer WITH ENCODING 'UTF8' TEMPLATE template0
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/xhs_crawer"

# ---- 安全（务必修改默认值）----
# JWT 签名密钥（生产环境必须改为随机字符串）
SECRET_KEY="dev-only-change-me"
# Fernet 加密密钥（可选，不填则由 SECRET_KEY 派生；用于加密 Cookie / API Key）
# 格式：base64 编码的 32 字节，可用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成
# FERNET_KEY=""

# ---- 调度 Worker ----
# worker 进程的任务周期（秒）
SCHEDULER_INTERVAL_SECONDS=60
# Cookie 健康巡检周期（小时）
COOKIE_HEALTH_CHECK_HOURS=2

# ---- 传输层（curl-impersonate）----
# curl-impersonate 可执行文件路径（含 curl_chrome116 等二进制）
CURL_IMPERSONATE_BIN=""
# 请求代理（可选）
# HTTPS_PROXY="http://127.0.0.1:7890"
